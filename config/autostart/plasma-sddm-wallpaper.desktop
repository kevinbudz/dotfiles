[Desktop Entry]
Type=Application
Name=Sync SDDM Sonoma Wallpaper
Comment=Updates the login screen background when Plasma starts
Exec=sh -c '"$HOME/.local/share/sddm/themes/sonoma/scripts/sync-wallpaper.sh" || "$HOME/Desktop/sonoma-sddm/scripts/sync-wallpaper.sh"'
X-KDE-Autostart-phase=1
X-KDE-autostart-after=plasma-workspace
OnlyShowIn=KDE;
