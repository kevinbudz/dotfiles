[ButtonBehaviour]
LockButtonBehaviourActiveInactive=false
ShowCloseOutlineOnHoverActive=false
ShowCloseOutlineOnHoverInactive=false
ShowCloseOutlineOnPressActive=false
ShowCloseOutlineOnPressInactive=false
ShowOutlineOnHoverActive=false
ShowOutlineOnHoverInactive=false
ShowOutlineOnPressActive=false
ShowOutlineOnPressInactive=false
VaryColorCloseOutlineActive=No
VaryColorCloseOutlineInactive=No
VaryColorOutlineActive=No
VaryColorOutlineInactive=No

[ButtonColors]
ButtonBackgroundColorsActive=TitleBarText
ButtonBackgroundColorsInactive=TitleBarText
CloseButtonIconColorActive=AsSelected
CloseButtonIconColorInactive=AsSelected

[ButtonSizing]
CloseFullHeightButtonWidthMarginRelative=110
FullHeightButtonWidthMarginLeft=8

[Global]
LookAndFeelSet=org.kde.breezedark.desktop

[TitleBarSpacing]
TitleBarBottomMargin=5
TitleBarTopMargin=5
TitleSidePadding=8

[Windeco]
ColorizeWindowOutlineWithButton=false
ButtonIconStyle=StyleMaterial
ButtonShape=ShapeFullHeightRectangle
IconSize=IconMedium
RoundAllCornersWhenNoBorders=true
WindowCornerRadius=8

[WindowOutlineStyle]
WindowOutlineStyleActive=WindowOutlineNone
WindowOutlineStyleInactive=WindowOutlineNone
WindowOutlineThickness=0.5
