{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.config/fastfetch/ascii.txt",
    "type": "file",
    "color": {
      "1": "#a7c4eb"
    },
    "padding": {
      "top": 0,
      "left": 0,
      "right": 3
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "#a7c4eb"
    }
  },
  "modules": [
    {
      "type": "title",
      "color": {
        "user": "#a7c4eb",
        "at": "white",
        "host": "#a7c4eb"
      }
    },
    {
      "type": "os",
      "key": " OS"
    },
    {
      "type": "host",
      "key": "󰌢 Host"
    },
    {
      "type": "kernel",
      "key": " Kernel"
    },
    {
      "type": "uptime",
      "key": " Uptime"
    },
    {
      "type": "shell",
      "key": " Shell"
    },
    {
      "type": "wm",
      "key": " WM"
    },
    {
      "type": "de",
      "key": " DE"
    },
    {
      "type": "memory",
      "key": " Memory"
    },
    {
      "type": "colors",
      "symbol": "square"
    }
  ]
}
